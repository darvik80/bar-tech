# ── Target ──
CONFIG_IDF_TARGET="esp32s3"

# ── Console — UART default (matches xiaozhi) ──
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ── WiFi ──
CONFIG_EMBED_WIFI_SSID="D15-03"
CONFIG_EMBED_WIFI_PASSWORD="66778899"
CONFIG_EMBED_WIFI_MAX_RETRY=5

# ── Metrics ──
CONFIG_EMBED_METRICS_INTERVAL_MS=10000
CONFIG_EMBED_METRICS_ENABLE_STORAGE=y

# ── MQTT ──
CONFIG_EMBED_MQTT_MAX_RETRY=5
CONFIG_EMBED_MQTT_RECONNECT_INTERVAL_MS=5000
CONFIG_EMBED_MQTT_KEEPALIVE=120

# ── Cogitor IoT ──
CONFIG_EMBED_COGITOR_IOT_PRODUCT_ID="home"
CONFIG_EMBED_COGITOR_IOT_DEVICE_ID="esp32-s3-ai"
CONFIG_EMBED_COGITOR_IOT_HOST="192.168.1.100"
CONFIG_EMBED_COGITOR_IOT_ACCESS_TOKEN="5Lz5JNwnxDwNXMI67iWiIwYRe22sA6G3Dj0FiORnfRQ"
CONFIG_EMBED_COGITOR_IOT_USE_TLS=n
CONFIG_EMBED_COGITOR_IOT_PORT=0
# CONFIG_EMBED_COGITOR_IOT_TOPIC_SHORT is not set

# ── FreeRTOS ──
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW=2

# ── Task watchdog — model init decompression can take >10s ──
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# ── Partition table (OTA-capable) ──
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"

# ── Flash ──
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ── PSRAM (required for esp-sr / voice detection) ──
#   WROOM-1-N8R8 / N16R8 → Octal (OPI)
#   …-N8R2 → Quad; set CONFIG_SPIRAM_MODE_QUAD=y and unset OCT
CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ── Config portal — BOOT (GPIO 0) hold while running ──
CONFIG_EMBED_CONFIG_RESET_GPIO=0
CONFIG_EMBED_CONFIG_RESET_HOLD_MS=3000
CONFIG_EMBED_CONFIG_RST_BURST_COUNT=3
CONFIG_EMBED_CONFIG_RST_BURST_CLEAR_MS=10000
CONFIG_EMBED_CONFIG_HTTP_STA=y
CONFIG_EMBED_CONFIG_HTTP_PORT=80

# ── Crypto ──
# Use software SHA to avoid linker ordering issue with sha_hal symbols
CONFIG_MBEDTLS_HARDWARE_SHA=n

# ── Stack sizes ──
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_EMBED_VOICE_DETECTION_FEED_TASK_STACK=16384
CONFIG_EMBED_VOICE_DETECTION_MN_COMMAND="HEY VITALYA"
CONFIG_EMBED_VOICE_DETECTION_MN_THRESHOLD=20
CONFIG_EMBED_PLAYBACK_TASK_STACK=16384
CONFIG_EMBED_UDP_AUDIO_RECV_TASK_STACK=4096

# ── lwip (UDP audio streaming needs generous buffers) ──
CONFIG_LWIP_MEM_SIZE=32768
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192

# ── ESP-SR: WakeNet models ──
CONFIG_SR_WN_WN9S_HIJASON=y
# CONFIG_SR_WN_WN9_HILEXIN is not set
CONFIG_SR_WN_WN9_ALEXA=y

# ── ESP-SR: MultiNet (English speech commands) ──
CONFIG_SR_MN_EN_MULTINET6_QUANT=y
# CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS is not set
